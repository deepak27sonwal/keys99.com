# Cloudflare Pages response headers - the equivalent of the
# Header and Expires rules in .htaccess, which Cloudflare ignores.
# build/cloudflare-dist.js copies this file into dist/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The <project>.pages.dev address serves the same site as keys99.com.
# Keep it out of search results for good, so it never competes with
# the real domain. (Stays after launch.)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Stylesheets and scripts are linked with ?v=<content hash>
# (build/asset-versions.js), so a changed file gets a new URL.
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800

# Images, as in .htaccess.
/assets/*
  Cache-Control: public, max-age=31536000
